# Environment variables this app reads.
#
# Copy to .env.local for local development:
#
#     cp .env.example .env.local
#
# .env* is gitignored, so .env.local never reaches the repo. Put real
# values there and in Vercel's project settings — never in this file,
# never in a commit, never pasted into a chat or a ticket.
#
# To confirm what production can actually see, without exposing any
# value:  curl -s https://joes-fac.vercel.app/api/debug/env-check
# It reports presence only.

# ─── Data source: the Pool Data workbook ─────────────────────────────
# Published-CSV URLs (File > Share > Publish to web > CSV).
GOOGLE_SHEET_CSV_URL=
GOOGLE_ENGAGEMENTS_CSV_URL=
GOOGLE_AVAILABILITY_CSV_URL=

# ─── Writes back to the sheet ────────────────────────────────────────
# Apps Script web-app /exec URL, plus the shared secret it checks.
# APPS_SCRIPT_AVAILABILITY_TOKEN must equal AVAILABILITY_TOKEN in the
# Apps Script project's Script Properties. It is currently unset in
# production, which means that endpoint accepts unauthenticated writes.
APPS_SCRIPT_AVAILABILITY_URL=
APPS_SCRIPT_AVAILABILITY_TOKEN=

# ─── LLM ─────────────────────────────────────────────────────────────
# Powers /chat, and is REQUIRED by /edit, /transcripts and /emails —
# those three parse with a model and have no heuristic fallback, so they
# cannot work without a key. /chat degrades to keyword matching.
#
# Provider selection in lib/llm.ts: OPENAI_API_KEY wins if it is set,
# and ANTHROPIC_API_KEY is then ignored. Leave OPENAI_API_KEY empty to
# use Anthropic.
#
# NOTE: these routes are reachable without authentication, so whoever
# holds the URL can spend against this key. Cap it at the Anthropic
# console with a workspace-scoped key and a monthly budget rather than
# using an org-wide one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides. Defaults: gpt-6-luna on the OpenAI path
# (both the tool-calling helper and the transcript/email extractor).
# The Anthropic default still pins
# claude-sonnet-4-5-20250929, which predates the Claude 5 family.
ANTHROPIC_MODEL=
OPENAI_MODEL=
OPENAI_EXTRACTION_MODEL=

# ─── Slack (older /proposals research flow) ──────────────────────────
# The previous /api/debug/env-check served the first 20 characters of
# this token publicly, so treat the current one as disclosed and rotate
# it before relying on it again.
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
